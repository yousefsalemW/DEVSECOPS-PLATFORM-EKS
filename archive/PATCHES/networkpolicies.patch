diff --git a/helm/vprofile/templates/80-networkpolicy.yaml b/helm/vprofile/templates/80-networkpolicy.yaml
new file mode 100644
index 0000000..db7cc04
--- /dev/null
+++ b/helm/vprofile/templates/80-networkpolicy.yaml
@@ -0,0 +1,149 @@
+{{- if .Values.networkPolicies.enabled }}
+# =============================================================================
+#  NetworkPolicies - workload isolation inside the vprofile namespace
+#
+#  PREREQUISITE: the vpc-cni addon must have enableNetworkPolicy=true (set in
+#  terraform/eks.tf). Without it every rule below is accepted and silently
+#  ignored. Verify enforcement, do not assume it - see NOTES at the bottom.
+#
+#  Design: default-deny BOTH directions, then open exactly the paths the
+#  application actually uses. Ingress-only rules would still let a compromised
+#  pod dial out and exfiltrate.
+#
+#  Traffic map this encodes:
+#     ALB ──▶ vproweb:80 ──▶ app01:8080 ──▶ db01:3306
+#                                       ├─▶ mc01:11211
+#                                       └─▶ rmq01:5672
+# =============================================================================
+apiVersion: networking.k8s.io/v1
+kind: NetworkPolicy
+metadata:
+  name: default-deny
+  labels: {{- include "vprofile.labels" . | nindent 4 }}
+spec:
+  # Empty podSelector = every pod in the namespace.
+  podSelector: {}
+  policyTypes: [Ingress, Egress]
+  # No rules at all: nothing in, nothing out. Everything below adds back.
+---
+# DNS must be allowed explicitly or every pod loses name resolution the moment
+# default-deny lands. This is the single most common way a first NetworkPolicy
+# rollout takes an application down.
+apiVersion: networking.k8s.io/v1
+kind: NetworkPolicy
+metadata:
+  name: allow-dns
+  labels: {{- include "vprofile.labels" . | nindent 4 }}
+spec:
+  podSelector: {}
+  policyTypes: [Egress]
+  egress:
+    - to:
+        - namespaceSelector:
+            matchLabels:
+              kubernetes.io/metadata.name: kube-system
+      ports:
+        - { protocol: UDP, port: 53 }
+        - { protocol: TCP, port: 53 }
+---
+# vproweb accepts :80 from the ALB. With target-type=ip the ALB reaches pod IPs
+# from its own ENIs, which are NOT pods - so this has to be an ipBlock of the
+# VPC, not a podSelector. That is a real limitation, not a shortcut.
+apiVersion: networking.k8s.io/v1
+kind: NetworkPolicy
+metadata:
+  name: vproweb-ingress
+  labels: {{- include "vprofile.labels" . | nindent 4 }}
+spec:
+  podSelector:
+    matchLabels:
+      app: vproweb
+  policyTypes: [Ingress]
+  ingress:
+    - from:
+        - ipBlock:
+            cidr: {{ .Values.networkPolicies.vpcCidr }}
+      ports:
+        - { protocol: TCP, port: 80 }
+---
+apiVersion: networking.k8s.io/v1
+kind: NetworkPolicy
+metadata:
+  name: vproweb-egress
+  labels: {{- include "vprofile.labels" . | nindent 4 }}
+spec:
+  podSelector:
+    matchLabels:
+      app: vproweb
+  policyTypes: [Egress]
+  egress:
+    - to:
+        - podSelector:
+            matchLabels:
+              app: app01
+      ports:
+        - { protocol: TCP, port: 8080 }
+---
+# The highest-value rule in this file: app01 is the ONLY thing that may open a
+# connection to the database. A compromised nginx cannot reach MySQL at all.
+apiVersion: networking.k8s.io/v1
+kind: NetworkPolicy
+metadata:
+  name: app01
+  labels: {{- include "vprofile.labels" . | nindent 4 }}
+spec:
+  podSelector:
+    matchLabels:
+      app: app01
+  policyTypes: [Ingress, Egress]
+  ingress:
+    - from:
+        - podSelector:
+            matchLabels:
+              app: vproweb
+      ports:
+        - { protocol: TCP, port: 8080 }
+  egress:
+    - to:
+        - podSelector:
+            matchLabels:
+              app: db01
+      ports:
+        - { protocol: TCP, port: 3306 }
+    - to:
+        - podSelector:
+            matchLabels:
+              app: mc01
+      ports:
+        - { protocol: TCP, port: 11211 }
+    - to:
+        - podSelector:
+            matchLabels:
+              app: rmq01
+      ports:
+        - { protocol: TCP, port: 5672 }
+---
+# The three backends accept only from app01, and are given NO egress rule at
+# all beyond DNS - a compromised database cannot call out to the internet.
+apiVersion: networking.k8s.io/v1
+kind: NetworkPolicy
+metadata:
+  name: backends-ingress
+  labels: {{- include "vprofile.labels" . | nindent 4 }}
+spec:
+  podSelector:
+    matchExpressions:
+      - key: app
+        operator: In
+        values: [db01, mc01, rmq01]
+  policyTypes: [Ingress]
+  ingress:
+    - from:
+        - podSelector:
+            matchLabels:
+              app: app01
+      ports:
+        - { protocol: TCP, port: 3306 }
+        - { protocol: TCP, port: 11211 }
+        - { protocol: TCP, port: 5672 }
+{{- end }}
