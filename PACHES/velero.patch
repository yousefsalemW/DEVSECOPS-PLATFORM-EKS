diff --git a/helm/vprofile/templates/10-db01.yaml b/helm/vprofile/templates/10-db01.yaml
index 790700c..a82d304 100644
--- a/helm/vprofile/templates/10-db01.yaml
+++ b/helm/vprofile/templates/10-db01.yaml
@@ -45,6 +45,29 @@ spec:
       labels:
         app: db01
         {{- include "vprofile.labels" . | nindent 8 }}
+      {{- if .Values.backup.hooks.enabled }}
+      # Velero backup hooks. An EBS snapshot of a running MySQL volume is
+      # CRASH-consistent: pages may still be in the InnoDB buffer pool when the
+      # snapshot is taken. InnoDB usually recovers on restore - "usually" is not
+      # a backup strategy.
+      #
+      # The pre-hook writes a logical dump INTO the volume, so the snapshot
+      # captures both the (possibly crash-consistent) datadir AND a known-good
+      # dump. Restore path: attach the volume, then
+      #   mysql -uroot -p"$MYSQL_ROOT_PASSWORD" accounts < /var/lib/mysql/backup/dump.sql
+      #
+      # A FLUSH TABLES WITH READ LOCK hook would NOT work here: the lock is
+      # released the moment the hook's session ends, which is before the
+      # snapshot is taken. This is the common mistake.
+      annotations:
+        pre.hook.backup.velero.io/container: mysql
+        pre.hook.backup.velero.io/command: >-
+          ["/bin/sh","-c","mkdir -p /var/lib/mysql/backup && mysqldump -uroot -p\"$MYSQL_ROOT_PASSWORD\" --single-transaction --routines --triggers --databases {{ .Values.db.name }} > /var/lib/mysql/backup/dump.sql"]
+        pre.hook.backup.velero.io/timeout: {{ .Values.backup.hooks.timeout | quote }}
+        # Non-zero exit fails the BACKUP, deliberately. A backup that silently
+        # skipped its consistency step is worse than a backup that failed loudly.
+        pre.hook.backup.velero.io/on-error: Fail
+      {{- end }}
     spec:
       containers:
         - name: mysql
