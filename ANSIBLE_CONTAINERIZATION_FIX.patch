+pipeline {
+    agent any
+
+    parameters {
+        string(name: 'INVENTORY', defaultValue: '/etc/ansible/inventory.ini',
+               description: 'Path to the real inventory on the Jenkins agent. Host addresses and SSH users are environment-specific and are never committed to this repository - see inventory.example.ini for the expected structure.')
+    }
+
+    stages {
+
+        stage('Checkout Source Code') {
+            steps {
+                echo "Downloading source code..."
+                checkout scm
+            }
+        }
+
+        stage('Show Workspace') {
+            steps {
+                echo "Workspace contents:"
+                sh 'pwd'
+                sh 'ls -lah'
+            }
+        }
+
+        stage('Preflight') {
+            steps {
+                echo "Checking inventory and reachability..."
+                sh """
+                    set -eu
+                    if [ ! -f "${params.INVENTORY}" ]; then
+                        echo "Inventory not found: ${params.INVENTORY}"
+                        echo "Copy inventory.example.ini to that path on this agent and fill it in."
+                        exit 1
+                    fi
+                    ansible -i "${params.INVENTORY}" production -m ping
+                """
+            }
+        }
+
+        stage('Run Ansible Playbooks') {
+            steps {
+                echo "Installing Docker..."
+                sh "ansible-playbook -i '${params.INVENTORY}' install-docker.yml"
+
+                echo "Deploying Web Application..."
+                sh "ansible-playbook -i '${params.INVENTORY}' deploy-webapp.yml"
+            }
+        }
+
+        stage('Verification') {
+            steps {
+                // Run against the managed hosts, not the Jenkins agent. The agent
+                // does not run the container, so 'docker ps' here verified nothing.
+                echo "Checking containers across the fleet..."
+                sh "ansible -i '${params.INVENTORY}' production -a 'docker ps'"
+            }
+        }
+    }
+
+    post {
+
+        success {
+            echo "Pipeline completed successfully."
+        }
+
+        failure {
+            echo "Pipeline failed."
+        }
+
+        always {
+            echo "Pipeline execution finished."
+        }
+    }
+}
