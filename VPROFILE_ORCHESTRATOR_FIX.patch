diff --git a/build-and-push.sh b/build-and-push.sh
index 0ba6b7b..4ebb1d8 100644
--- a/build-and-push.sh
+++ b/build-and-push.sh
@@ -16,13 +16,46 @@ docker build --platform "$PLATFORM" -t "$DHUB/vprofile-db:$TAG"  -f images/db/Do
 docker build --platform "$PLATFORM" -t "$DHUB/vprofile-mc:$TAG"  -f images/memcached/Dockerfile images/memcached/
 docker build --platform "$PLATFORM" -t "$DHUB/vprofile-rmq:$TAG" -f images/rabbitmq/Dockerfile  images/rabbitmq/
 
-# 2) scan (fail the build on HIGH/CRITICAL if you drop '|| true')
+# 2) scan — this is a GATE, not a report.
+#    trivy exit codes as used here:
+#      0 = clean at severity | 2 = findings at severity | 1 = trivy itself failed
+#    Two things were needed to make this enforce: removing '|| true' (which
+#    substitutes exit 0 and defeats `set -e`) AND adding --exit-code, because
+#    trivy defaults to --exit-code 0 and would otherwise never signal findings.
+#    All four images are scanned before any decision, so the operator sees the
+#    complete picture rather than stopping at the first failure.
+#    GATE=0 falls back to audit mode: scan, report, push anyway.
+GATE="${GATE:-1}"
+FAILED=""
+
 for s in app db mc rmq; do
   echo "== scanning $s =="
-  trivy image --severity HIGH,CRITICAL --ignore-unfixed "$DHUB/vprofile-$s:$TAG" || true
+  set +e
+  trivy image --severity HIGH,CRITICAL --ignore-unfixed --exit-code 2 \
+    "$DHUB/vprofile-$s:$TAG"
+  rc=$?
+  set -e
+  case "$rc" in
+    0) echo "   clean" ;;
+    2) echo "   FINDINGS at HIGH/CRITICAL"; FAILED="$FAILED $s" ;;
+    *) echo "   trivy failed to scan (exit $rc)"; FAILED="$FAILED $s(scan-error)" ;;
+  esac
 done
 
-# 3) push
+if [ -n "$FAILED" ] && [ "$GATE" = "1" ]; then
+  echo
+  echo "SECURITY GATE FAILED - no images pushed."
+  echo "Affected:$FAILED"
+  echo "Fix the base image or dependency, then re-run."
+  echo "To scan and push anyway (audit mode):  GATE=0 ./build-and-push.sh"
+  exit 2
+fi
+
+if [ -n "$FAILED" ]; then
+  echo "WARNING: pushing despite findings because GATE=0 -$FAILED"
+fi
+
+# 3) push - only reached when the gate passed, or was explicitly disabled
 docker login -u "$DHUB"
 for s in app db mc rmq; do docker push "$DHUB/vprofile-$s:$TAG"; done
 echo "done."
