+    // the build has to be checked with returnStatus, never through a pipe.
+    def unreachable = sh(returnStatus: true, script: """
+        kubectl -n ${params.K8S_NAMESPACE} get pods --request-timeout=20s > /dev/null 2>&1
+    """)
+    if (unreachable != 0) {
+        error("""Cannot list pods in namespace '${params.K8S_NAMESPACE}'.
+
+Either the namespace does not exist, or this role cannot see it. The namespace
+is created by the PLATFORM pipeline, not this one - it is a cluster-scoped
+write, and jenkins-ec2-role deliberately cannot perform it.
+
+Run the platform pipeline once (MODE=deploy) against a fresh cluster, or do it
+by hand after assuming the platform role:
+  kubectl create namespace ${params.K8S_NAMESPACE}""")
+    }
+
     // Both credentials are required by the chart (db.existingSecret and
