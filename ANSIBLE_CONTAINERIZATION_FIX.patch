diff --git a/ansible.cfg b/ansible.cfg
new file mode 100644
index 0000000..6299a68
--- /dev/null
+++ b/ansible.cfg
@@ -0,0 +1,16 @@
+[defaults]
+inventory           = ./inventory.ini
+roles_path          = ./roles
+retry_files_enabled = False
+stdout_callback     = yaml
+interpreter_python  = auto_silent
+
+# Disabled because the managed hosts are freshly provisioned lab VMs whose
+# host keys are not known in advance, and because the Jenkins agent runs these
+# playbooks unattended. Remove this line when running against hosts whose keys
+# you have already accepted.
+host_key_checking   = False
+
+[privilege_escalation]
+become        = True
+become_method = sudo
diff --git a/inventory.example.ini b/inventory.example.ini
new file mode 100644
index 0000000..2ca637e
--- /dev/null
+++ b/inventory.example.ini
@@ -0,0 +1,24 @@
+# =====================================================================
+#  Example inventory - copy to inventory.ini and fill in real values.
+#
+#      cp inventory.example.ini inventory.ini
+#
+#  inventory.ini is git-ignored. Never commit real addresses or users.
+#  The addresses below are RFC 5737 documentation addresses and are
+#  deliberately unroutable, so this file cannot reach anything.
+#
+#  Both playbooks target the group [production] and run with become: true,
+#  so the SSH user needs passwordless sudo on every host.
+#
+#  Authentication is by SSH key only. Do not add ansible_password here.
+# =====================================================================
+
+[production]
+rocky   ansible_host=192.0.2.11
+ubuntu  ansible_host=192.0.2.12
+test    ansible_host=192.0.2.13
+
+[production:vars]
+ansible_user=REPLACE_ME
+ansible_ssh_private_key_file=~/.ssh/REPLACE_ME.pem
+ansible_python_interpreter=/usr/bin/python3
