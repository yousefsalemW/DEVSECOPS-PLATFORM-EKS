diff --git a/k8s/01-secret.example.yaml b/k8s/01-secret.example.yaml
new file mode 100644
index 0000000..63f754b
--- /dev/null
+++ b/k8s/01-secret.example.yaml
@@ -0,0 +1,35 @@
+# -------------------------------------------------------------------
+#  EXAMPLE ONLY - do not apply as-is, and never commit real values.
+#
+#  One Secret feeds db01, rmq01 AND app01 at runtime. Because the app
+#  image carries no credentials, this Secret is the single source of
+#  truth: change a value here and every tier follows on restart.
+#
+#  Create the real object out of band:
+#
+#    kubectl -n vprofile create secret generic app-secret \
+#      --from-literal=db-root-password="$(openssl rand -base64 24)" \
+#      --from-literal=db-user=vprofile \
+#      --from-literal=db-password="$(openssl rand -base64 24)" \
+#      --from-literal=rmq-user=vprofile \
+#      --from-literal=rmq-password="$(openssl rand -base64 24)"
+#
+#  Keys consumed by:
+#    db-root-password -> db01  (MYSQL_ROOT_PASSWORD)
+#    db-user          -> db01  (MYSQL_USER)      + app01 (JDBC_USERNAME)
+#    db-password      -> db01  (MYSQL_PASSWORD)  + app01 (JDBC_PASSWORD)
+#    rmq-user         -> rmq01 (RABBITMQ_DEFAULT_USER) + app01 (RABBITMQ_USERNAME)
+#    rmq-password     -> rmq01 (RABBITMQ_DEFAULT_PASS) + app01 (RABBITMQ_PASSWORD)
+# -------------------------------------------------------------------
+apiVersion: v1
+kind: Secret
+metadata:
+  name: app-secret
+  namespace: vprofile
+type: Opaque
+stringData:
+  db-root-password: "REPLACE_ME"
+  db-user: "REPLACE_ME"
+  db-password: "REPLACE_ME"
+  rmq-user: "REPLACE_ME"
+  rmq-password: "REPLACE_ME"
