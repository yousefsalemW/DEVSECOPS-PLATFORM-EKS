+++ b/helm/vprofile/templates/05-serviceaccounts.yaml
@@ -0,0 +1,31 @@
+{{- if .Values.serviceAccounts.enabled }}
+# =============================================================================
+#  Per-workload ServiceAccounts
+#
+#  WHY THIS EXISTS, and why it comes BEFORE Vault:
+#
+#  A ServiceAccount is a Kubernetes identity, and its full name is
+#  <namespace>:<name>. Vault's Kubernetes auth method works by validating the
+#  SA token a pod presents, then mapping THAT identity to a Vault policy.
+#
+#  Until now every pod in this namespace ran as the namespace `default`
+#  ServiceAccount. Vault could not have told app01 apart from vproweb, so any
+#  policy written against `default` would hand the database password to the
+#  nginx pods too - which defeats the point of using Vault at all.
+#
+#  Separately: automountServiceAccountToken is false on every workload that has
+#  no reason to talk to the Kubernetes API. A mounted token is a credential
+#  sitting inside a container that has no use for it.
+# =============================================================================
+{{- range $name := list "db01" "mc01" "rmq01" "vproweb" "app01" }}
+---
+apiVersion: v1
+kind: ServiceAccount
+metadata:
+  name: {{ $name }}
+  labels: {{- include "vprofile.labels" $ | nindent 4 }}
+# app01 keeps its token: the Vault Agent Injector uses it to authenticate on
+# the pod's behalf. The other four have no such need.
+automountServiceAccountToken: {{ eq $name "app01" }}
+{{- end }}
+{{- end }}
